<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de elegir equipo (SeleccionActivity).
  Arriba el título y un panel con las 3 ranuras del equipo (se rellenan al
  elegir). En medio una cuadrícula de 2 columnas con las tarjetas: está vacía a
  propósito, SeleccionActivity infla item_criatura.xml 6 veces y las añade con
  addView(). Abajo el botón de combatir.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_pantalla"
    tools:context=".pantallas.SeleccionActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seleccion_titulo"
        android:textColor="@color/texto_blanco"
        android:textSize="@dimen/texto_titulo_pantalla"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seleccion_subtitulo"
        android:textColor="@color/texto_tenue"
        android:textSize="@dimen/texto_normal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="2dp" />

    <!-- Panel con las tres ranuras del equipo y el contador. baselineAligned="false"
         porque el hijo con peso es un LinearLayout, no un texto: no hay línea base
         que alinear y así me ahorro una pasada de medida. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:background="@drawable/panel_translucido"
        android:layout_marginStart="@dimen/margen"
        android:layout_marginEnd="@dimen/margen"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:padding="10dp">

        <!-- solo padding al inicio: separa el texto del borde, las ranuras ya llevan su margen -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seleccion_tu_equipo"
                android:textColor="@color/texto_blanco"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/contador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_tenue"
                android:textSize="@dimen/texto_ayuda"
                tools:text="1 / 3" />
        </LinearLayout>

        <!-- Cada ranura lleva 6dp de margen al inicio para separarse de la anterior -->
        <FrameLayout
            android:id="@+id/slot_fondo_0"
            android:layout_width="@dimen/tam_slot"
            android:layout_height="@dimen/tam_slot"
            android:layout_marginStart="6dp"
            android:background="@drawable/slot_vacio">

            <com.juego.combates.vistas.VistaCriatura
                android:id="@+id/slot_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_fondo_1"
            android:layout_width="@dimen/tam_slot"
            android:layout_height="@dimen/tam_slot"
            android:layout_marginStart="6dp"
            android:background="@drawable/slot_vacio">

            <com.juego.combates.vistas.VistaCriatura
                android:id="@+id/slot_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_fondo_2"
            android:layout_width="@dimen/tam_slot"
            android:layout_height="@dimen/tam_slot"
            android:layout_marginStart="6dp"
            android:background="@drawable/slot_vacio">

            <com.juego.combates.vistas.VistaCriatura
                android:id="@+id/slot_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <GridLayout
            android:id="@+id/cuadricula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />
    </ScrollView>

    <!-- Empieza apagado (gris); SeleccionActivity lo pone verde al completar el equipo -->
    <Button
        android:id="@+id/boton_combatir"
        style="@style/BotonPrimario"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_boton"
        android:layout_margin="@dimen/margen"
        android:text="@string/seleccion_combatir"
        android:textSize="@dimen/texto_boton_grande"
        android:stateListAnimator="@animator/boton_pulsado"
        android:backgroundTint="@color/boton_apagado" />
</LinearLayout>
