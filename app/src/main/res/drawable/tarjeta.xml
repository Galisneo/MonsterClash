<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de una tarjeta sin seleccionar. Su pareja es tarjeta_seleccionada.xml. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_suave">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_panel" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/fondo_panel_borde" />
        </shape>
    </item>
</ripple>
