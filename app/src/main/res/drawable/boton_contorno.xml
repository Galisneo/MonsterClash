<?xml version="1.0" encoding="utf-8"?>
<!-- Botón "fantasma": solo el borde, para acciones secundarias como Cómo jugar. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_medio">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/radio_boton" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/relleno_cristal" />
            <stroke android:width="2dp" android:color="@color/borde_cristal" />
            <corners android:radius="@dimen/radio_boton" />
        </shape>
    </item>
</ripple>
