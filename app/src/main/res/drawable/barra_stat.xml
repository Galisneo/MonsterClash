<?xml version="1.0" encoding="utf-8"?>
<!--
  Barra de progreso fina para las estadísticas y la vida. Los ids background y
  progress son los que espera ProgressBar. El color del progreso se pone desde
  código con setProgressTintList.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/barra_fondo" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
